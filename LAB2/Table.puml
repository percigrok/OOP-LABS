@startuml

class Book {
    - title: String
    - author: String
    - pageCount: PageCount
    - isBorrowed: bool
    - {static} totalBooks: int

    + Book()
    + Book(title: String, author: String, pageCount: PageCount)
    + Book(title: String, author: String, pageCount: PageCount, isBorrowed: bool)
    ~ Book()

    + getTitle(): String
    + getPageCount(): int
    + {static} getTotalBooks(): int

    + borrowBook(): bool
    + returnBook(): bool
    + updatePageCount(newPageCount: int): bool

    + print(): void
}

class PageCount {
    - value: int

    + PageCount()
    + PageCount(pages: int)

    + getValue(): int
    + setValue(newValue: int): bool
    + print(): void
}

Book *-- PageCount : contains

note right of Book::pageCount
    Invariant:
    pageCount > 0
end note

note right of Book::borrowBook
    Invariant:
    Cannot borrow an
    already borrowed book
end note

note right of Book::returnBook
    Invariant:
    Cannot return a
    book that is not borrowed
end note

@enduml